# ==============================================================================
# CẤU HÌNH CAMERA MÁY TÍNH NGOÀI (LAPTOP PHÁT WEBCAM CHO RASPBERRY PI)
# ==============================================================================
# Điền địa chỉ IP máy tính phát webcam vào đây (ví dụ: 172.16.1.241 hoặc 192.168.1.100)
CAMERA_IP=192.168.163.177
CAMERA_PORT=5000
CAMERA_ENDPOINT=/video
CAMERA_DEVICE=http://192.168.163.177:5000/video
# (Nếu cắm USB Camera trực tiếp vào Raspberry Pi, để trống CAMERA_IP và đặt: CAMERA_DEVICE=0)
# CAMERA_DEVICE=0

# ==============================================================================
# CẤU HÌNH PHẦN CỨNG 4 NGĂN TỦ (PCA9685 & 4 CẢM BIẾN TỪ MC-38)
# ==============================================================================
# I2C Module PCA9685 điều khiển 4 Servo:
# - Chân SDA: GPIO 2 (Pin 3)
# - Chân SCL: GPIO 3 (Pin 5)
PCA_BUS=1
PCA_ADDR=0x40

# Kênh cắm trên PCA9685 cho 4 Servo (Bạn có thể cắm kênh bất kỳ từ 0 đến 15):
SERVO_1_CHANNEL=0
SERVO_2_CHANNEL=3
SERVO_3_CHANNEL=12
SERVO_4_CHANNEL=15

# 4 Chân GPIO Cảm biến từ MC-38 (Nối vào GPIO và GND):
DOOR_1_PIN=23
DOOR_2_PIN=24
DOOR_3_PIN=25
DOOR_4_PIN=26

# Đèn LED cảnh báo & báo thành công:
RED_LED_PIN=17
GREEN_LED_PIN=27

# Cấu hình AI Nhận diện & Chống giả mạo
# Ngưỡng nhận diện khuôn mặt Cosine (0.0 đến 1.0):
# - 0.363: Mặc định tối thiểu OpenCV (quá dễ dãi, dễ nhận nhầm)
# - 0.50: Khuyên dùng cho Smart Locker (chính xác, an toàn, không giật mở vội)
# - 0.60: Rất nghiêm ngặt
FACE_THRESHOLD=0.50

# Cấu hình Web Server
PORT=8080
SECRET_KEY=smart-locker-secret-2026

# Đặt = 1 nếu muốn ép chế độ mô phỏng phần cứng (chạy test trên PC không có Pi)
MOCK_GPIO=0
