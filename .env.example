# CẤU HÌNH THÔNG SỐ HỆ THỐNG SMART LOCKER IOT
# Tạo một bản sao và đặt tên là .env để kích hoạt cấu hình này:
# cp .env.example .env

# ==============================================================================
# CẤU HÌNH CAMERA:
# - Cách 1 (Phát từ Laptop sang Pi): Nhập URL stream phát từ laptop (ví dụ cam_server.py):
#   CAMERA_DEVICE=http://192.168.1.100:5000/video
#
# - Cách 2 (Camera USB cắm ngoài vào Máy tính/Pi):
#   CAMERA_DEVICE=1  (hoặc 0 nếu là camera duy nhất)
#
# - Cách 3 (Webcam tích hợp sẵn của Laptop):
#   CAMERA_DEVICE=0
# ==============================================================================
CAMERA_DEVICE=0

# Cấu hình chân GPIO trên Raspberry Pi
SERVO_PIN=18
DOOR_SENSOR_PIN=23
RED_LED_PIN=17
GREEN_LED_PIN=27

# Cổng Web Server
PORT=5000
SECRET_KEY=smart-locker-secret-2026

# Đặt = 1 nếu muốn ép chế độ mô phỏng ngay cả trên Pi
MOCK_GPIO=0

