# CẤU HÌNH THÔNG SỐ HỆ THỐNG SMART LOCKER IOT
# Đổi tên file này thành .env nếu muốn tùy chỉnh

# Camera: "0", "1" (USB Cam) hoặc đường dẫn RTSP/HTTP (http://192.168.1.100:8080/video)
CAMERA_DEVICE=0

# Cấu hình chân GPIO trên Raspberry Pi
SERVO_PIN=18
DOOR_SENSOR_PIN=23
RED_LED_PIN=17
GREEN_LED_PIN=27

# Cổng Web Server
PORT=5000
SECRET_KEY=smart-locker-secret-2026

# Đặt = 1 nếu muốn ép chế độ mô phỏng ngay cả trên Pi
MOCK_GPIO=0

