# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C environments & Virtualenv
.venv/
venv/
env/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Data & Database (dữ liệu phát sinh lúc chạy thực tế)
data/*.db
data/*.sqlite3
data/faces/*
!data/faces/.gitkeep
!data/.gitkeep

# Model files (tải tự động qua ./download_models.sh hoặc download_models.py)
# Bỏ comment nếu muốn đẩy model lên git (lưu ý file SFace nặng ~37MB)
models/*.onnx
!models/.gitkeep

# Environment variables & secrets
.env
.env.local

# IDE & Editor files
.vscode/
.idea/
*.swp
*.swo

# OS generated files
.DS_Store
Thumbs.db
Desktop.ini

